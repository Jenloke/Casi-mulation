{
  "name": "casi-mulation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "pnpm --filter @casino/e2e test:e2e",
    "ui:add": "pnpm --filter @casino/ui exec shadcn add"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  }
}
